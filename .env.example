# Supabase プロジェクト設定 (https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Mapbox アクセストークン (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Meta Developerアプリ (https://developers.facebook.com/apps/)
# スポット詳細画面のInstagram引用カード(サムネイル取得)で使用する。
# api/instagram-oembed.ts でのみ使用するサーバー専用の値のため、
# EXPO_PUBLIC_ プレフィックスを付けず、クライアント側に絶対に露出させないこと。
# 取得方法: developers.facebook.com でアプリを作成し、
# 「設定」>「ベーシック」に表示されるアプリID/アプリシークレットを使う。
# 自社アカウント以外(第三者)の投稿を埋め込むには、Meta側の「App Review」で
# oEmbed Read の承認が別途必要。
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
