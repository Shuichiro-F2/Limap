# Supabase プロジェクト設定 (https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Mapbox アクセストークン (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Instagram/Xの埋め込みサムネイル取得(api/instagram-oembed.ts, api/x-oembed.ts)は
# どちらも各プラットフォームの公開ページから直接取得する方式のため、
# APIキーなど追加の環境変数は不要。
