# Supabase プロジェクト設定 (https://app.supabase.com/project/_/settings/api)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Mapbox アクセストークン (https://account.mapbox.com/access-tokens/)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Instagram/Xの埋め込みサムネイル取得(api/instagram-oembed.ts, api/x-oembed.ts)は
# どちらも各プラットフォームの公開ページから直接取得する方式のため、
# APIキーなど追加の環境変数は不要。

# Mapbox SDK ダウンロード用シークレットトークン（sk.〜、スコープ DOWNLOADS:READ）
# ネイティブビルド時に app.config.js が読み込む。EAS 上でビルドする場合は EAS の環境変数にも登録する
MAPBOX_DOWNLOAD_TOKEN=sk.your-mapbox-download-token

# --- 以下は .env には書かない（参考） ---
# SUPABASE_SERVICE_ROLE_KEY : api/delete-account.ts が使用。Vercel の環境変数にのみ設定する
# OFFICIAL_EMAIL / OFFICIAL_PASSWORD（/ OFFICIAL_USERNAME / OFFICIAL_DISPLAY_NAME）
#   : scripts/seed/*.mjs の実行時にコマンドラインで渡す
# OWNER_EMAIL / OWNER_PASSWORD : scripts/seed/optimize-existing-images.mjs の実行時にコマンドラインで渡す
