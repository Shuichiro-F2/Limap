{
  "buildCommand": "npx expo export --platform web",
  "installCommand": "npm install --legacy-peer-deps",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/spot/:id", "destination": "/api/spot?id=:id" },
    { "source": "/about", "destination": "/api/page?slug=about" },
    { "source": "/help", "destination": "/api/page?slug=help" },
    { "source": "/privacy", "destination": "/api/page?slug=privacy" },
    { "source": "/terms", "destination": "/api/page?slug=terms" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
